{
  "name": "assignment-generator-monorepo",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"frontend,backend\" -c \"cyan,magenta\" \"bun run --cwd frontend dev\" \"bun run --cwd backend dev\"",
    "build": "bun run --cwd frontend build"
  },
  "devDependencies": {
    "@types/react-speech-recognition": "^3.9.6",
    "concurrently": "^9.1.2",
    "react-speech-recognition": "^4.0.1"
  },
  "dependencies": {
    "pdf-parse-new": "^2.1.0"
  }
}
